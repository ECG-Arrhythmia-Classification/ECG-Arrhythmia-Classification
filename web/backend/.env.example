# API reads process environment variables; it does not auto-load this file.
# Default: the three original trained checkpoints included in the repository.
ECG_RUNTIME=trained

ECG_CNN_CHECKPOINT=results/cnn/best_cnn_model.pt
ECG_CNN_CHECKPOINT_FORMAT=native
ECG_CNN_PIPELINE=team
ECG_CNN_INPUT_LAYOUT=channels_first
ECG_CNN_OUTPUT_KIND=logits

ECG_RNN_CHECKPOINT=saved_models/best_rnn_model.pth
ECG_RNN_CHECKPOINT_FORMAT=native
ECG_RNN_PIPELINE=team
ECG_RNN_INPUT_LAYOUT=sequence
ECG_RNN_OUTPUT_KIND=logits

ECG_TRANSFORMER_CHECKPOINT=results/transformer/best_model.pt
ECG_TRANSFORMER_CHECKPOINT_FORMAT=native
ECG_TRANSFORMER_PIPELINE=team
ECG_TRANSFORMER_INPUT_LAYOUT=channels_first
ECG_TRANSFORMER_OUTPUT_KIND=logits

# Own TorchScript: set FORMAT=torchscript and CHECKPOINT=checkpoints/model.ts.pt.
# Prototype scorers: ECG_RUNTIME=demo, omit all CHECKPOINT overrides.
# A failed trained model never silently falls back to demo.
# Browser origins: scheme + hostname + optional port, without a trailing /.
ECG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
