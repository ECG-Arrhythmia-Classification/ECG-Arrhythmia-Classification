# EXAMPLE ONLY: no trained checkpoint is included in the repository.
# The backend reads process environment variables, not this file automatically.
# Omit CHECKPOINT variables to keep the corresponding prototype demo enabled.
# Paths below are examples, resolved relative to the repository root.
ECG_CNN_CHECKPOINT=checkpoints/cnn.ts.pt
ECG_CNN_PIPELINE=team
ECG_CNN_INPUT_LAYOUT=channels_first
ECG_CNN_OUTPUT_KIND=logits

ECG_RNN_CHECKPOINT=checkpoints/rnn.ts.pt
ECG_RNN_PIPELINE=team
ECG_RNN_INPUT_LAYOUT=sequence
ECG_RNN_OUTPUT_KIND=logits

ECG_TRANSFORMER_CHECKPOINT=checkpoints/transformer.ts.pt
ECG_TRANSFORMER_PIPELINE=team
ECG_TRANSFORMER_INPUT_LAYOUT=sequence
ECG_TRANSFORMER_OUTPUT_KIND=logits

# Browser origins only: scheme + hostname + optional port, without a trailing /.
# Add the actual hosted frontend origin when deploying an HTTPS API.
ECG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
